@model List<RequestRow>
@if (Model.Count == 0)
{
    <p class="empty">No requests match.</p>
}
else
{
    <table class="table">
        <thead>
            <tr><th>Request</th><th>Category</th><th>Location</th><th>Status</th><th>Priority</th><th>Submitted</th><th>Target date</th></tr>
        </thead>
        <tbody>
        @foreach (var r in Model)
        {
            <tr class="@(r.IsOverdue ? "row-overdue" : "")">
                <td><a asp-controller="Requests" asp-action="Details" asp-route-id="@r.RequestId">@r.RequestNumber</a></td>
                <td>@r.Category<br /><small class="muted">@r.Department</small></td>
                <td>@r.LocationText<br /><small class="muted">@r.Municipality</small></td>
                <td><span class="@Display.StatusCss(r.StatusCode)">@r.StatusName</span></td>
                <td>@r.Priority</td>
                <td>@r.SubmittedAtUtc.Local()</td>
                <td>@r.DueDate.ToString("yyyy-MM-dd") @if (r.IsOverdue) { <span class="badge-alert">Overdue</span> }</td>
            </tr>
        }
        </tbody>
    </table>
}
