<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="PublicServicePortal">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=localhost,1433;Initial Catalog=PublicServicePortal;Encrypt=True;TrustServerCertificate=True</ConnectString>
        <Prompt>Sign in as portal_reports (read-only rpt_reader role)</Prompt>
      </ConnectionProperties>
      <rd:DataSourceID>3f1b0f40-0000-4000-8000-000000000005</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="Data">
      <Query>
        <DataSourceName>PublicServicePortal</DataSourceName>
        <QueryParameters><QueryParameter Name="@Year"><Value>=Parameters!Year.Value</Value></QueryParameter></QueryParameters>
        <CommandText>SELECT YearMonth, DivisionName, DepartmentName,
       SUM(ClosedRequests) AS ClosedRequests,
       SUM(MetSla) AS MetSla,
       CAST(100.0 * SUM(MetSla) / NULLIF(SUM(ClosedRequests), 0) AS decimal(5,1)) AS SlaPct,
       CAST(SUM(AvgBusinessDays * ClosedRequests) / NULLIF(SUM(ClosedRequests), 0) AS decimal(9,1)) AS AvgBusinessDays
FROM rpt.vw_SlaComplianceMonthly
WHERE [Year] = @Year
GROUP BY YearMonth, DivisionName, DepartmentName
ORDER BY YearMonth, DivisionName, DepartmentName</CommandText>
      </Query>
      <Fields><Field Name="YearMonth"><DataField>YearMonth</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="DivisionName"><DataField>DivisionName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="DepartmentName"><DataField>DepartmentName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="ClosedRequests"><DataField>ClosedRequests</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="MetSla"><DataField>MetSla</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="SlaPct"><DataField>SlaPct</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="AvgBusinessDays"><DataField>AvgBusinessDays</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field></Fields>
    </DataSet>
  </DataSets>
  <ReportParameters><ReportParameter Name="Year"><DataType>Integer</DataType><DefaultValue><Values><Value>=Year(Today())</Value></Values></DefaultValue><Prompt>Year</Prompt></ReportParameter></ReportParameters>
  <Body>
    <ReportItems>
      <Textbox Name="Title"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph><TextRuns><TextRun><Value>Service Request SLA Compliance</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>16pt</FontSize><FontWeight>Bold</FontWeight><Color>#0B5D4B</Color></Style></TextRun></TextRuns><Style /></Paragraph>
          <Paragraph><TextRuns><TextRun><Value>On-time completion against each category's service standard (business days). Source: rpt.vw_SlaComplianceMonthly</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><Color>#5B6875</Color></Style></TextRun></TextRuns><Style /></Paragraph>
        </Paragraphs>
        <Top>0in</Top><Left>0in</Left><Height>0.6in</Height><Width>8.6in</Width><Style />
      </Textbox>
      <Tablix Name="DataTable">
        <TablixBody>
          <TablixColumns><TablixColumn><Width>0.9in</Width></TablixColumn><TablixColumn><Width>1.9in</Width></TablixColumn><TablixColumn><Width>1.9in</Width></TablixColumn><TablixColumn><Width>0.9in</Width></TablixColumn><TablixColumn><Width>0.9in</Width></TablixColumn><TablixColumn><Width>0.9in</Width></TablixColumn><TablixColumn><Width>1.2in</Width></TablixColumn></TablixColumns>
          <TablixRows>
            <TablixRow><Height>0.3in</Height><TablixCells><TablixCell><CellContents><Textbox Name="h0"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
<Paragraphs><Paragraph><TextRuns><TextRun><Value>Month</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs>
<rd:DefaultName>h0</rd:DefaultName><Style><Border><Color>#D9DEE4</Color><Style>Solid</Style></Border><BackgroundColor>#0B5D4B</BackgroundColor><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="h1"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
<Paragraphs><Paragraph><TextRuns><TextRun><Value>Division</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs>
<rd:DefaultName>h1</rd:DefaultName><Style><Border><Color>#D9DEE4</Color><Style>Solid</Style></Border><BackgroundColor>#0B5D4B</BackgroundColor><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="h2"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
<Paragraphs><Paragraph><TextRuns><TextRun><Value>Department</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs>
<rd:DefaultName>h2</rd:DefaultName><Style><Border><Color>#D9DEE4</Color><Style>Solid</Style></Border><BackgroundColor>#0B5D4B</BackgroundColor><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="h3"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
