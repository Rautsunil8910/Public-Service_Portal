<Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!ClosedRequests.Value</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><Format>#,0</Format></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs>
