<rd:DefaultName>h0</rd:DefaultName><Style><Border><Color>#D9DEE4</Color><Style>Solid</Style></Border><BackgroundColor>#0B5D4B</BackgroundColor><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="h1"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
<Paragraphs><Paragraph><TextRuns><TextRun><Value>Department</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs>
