<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="PublicServicePortal">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=localhost,1433;Initial Catalog=PublicServicePortal;Encrypt=True;TrustServerCertificate=True</ConnectString>
        <Prompt>Sign in as portal_reports (read-only rpt_reader role)</Prompt>
      </ConnectionProperties>
      <rd:DataSourceID>3f1b0f40-0000-4000-8000-000000000006</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="Data">
      <Query>
        <DataSourceName>PublicServicePortal</DataSourceName>
        <QueryParameters><QueryParameter Name="@MinPriority"><Value>=Parameters!MinPriority.Value</Value></QueryParameter></QueryParameters>
        <CommandText>SELECT DivisionName, DepartmentName, CategoryName, Priority, OpenRequests, OverdueRequests, OldestBusinessDays
FROM rpt.vw_OpenRequestsByDepartment
WHERE (@MinPriority IS NULL OR Priority &lt;= @MinPriority)
ORDER BY DivisionName, DepartmentName, OverdueRequests DESC</CommandText>
      </Query>
      <Fields><Field Name="DivisionName"><DataField>DivisionName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="DepartmentName"><DataField>DepartmentName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="CategoryName"><DataField>CategoryName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Priority"><DataField>Priority</DataField><rd:TypeName>System.Byte</rd:TypeName></Field><Field Name="OpenRequests"><DataField>OpenRequests</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="OverdueRequests"><DataField>OverdueRequests</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="OldestBusinessDays"><DataField>OldestBusinessDays</DataField><rd:TypeName>System.Int32</rd:TypeName></Field></Fields>
    </DataSet>
  </DataSets>
  <ReportParameters><ReportParameter Name="MinPriority"><DataType>Integer</DataType><DefaultValue><Values><Value>4</Value></Values></DefaultValue><Prompt>Show priorities up to (1 = urgent only, 4 = all)</Prompt></ReportParameter></ReportParameters>
  <Body>
    <ReportItems>
      <Textbox Name="Title"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph><TextRuns><TextRun><Value>Open Service Requests by Department</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>16pt</FontSize><FontWeight>Bold</FontWeight><Color>#0B5D4B</Color></Style></TextRun></TextRuns><Style /></Paragraph>
          <Paragraph><TextRuns><TextRun><Value>Snapshot as of the last nightly warehouse load. Source: rpt.vw_OpenRequestsByDepartment</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><Color>#5B6875</Color></Style></TextRun></TextRuns><Style /></Paragraph>
        </Paragraphs>
        <Top>0in</Top><Left>0in</Left><Height>0.6in</Height><Width>9.0in</Width><Style />
      </Textbox>
      <Tablix Name="DataTable">
        <TablixBody>
          <TablixColumns><TablixColumn><Width>1.8in</Width></TablixColumn><TablixColumn><Width>1.8in</Width></TablixColumn><TablixColumn><Width>1.9in</Width></TablixColumn><TablixColumn><Width>0.7in</Width></TablixColumn><TablixColumn><Width>0.8in</Width></TablixColumn><TablixColumn><Width>0.8in</Width></TablixColumn><TablixColumn><Width>1.2in</Width></TablixColumn></TablixColumns>
          <TablixRows>
